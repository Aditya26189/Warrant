    {
      "field_path": "arm_inventory[0]",
      "decision": "APPROVE",
      "semantic_fidelity": "Actual LM-Judge86 and runtime103-109/172 tag full-context regions and run the judge before each new agent message. No current original-task completion is explicitly needed for that judge, while prior conversation state may be present. Its label is region relevance/dependency for a next action, not prompt-injection presence.",
      "restriction_rationale": "Bounded method/data or coverage fact only; source outcomes, sample counts, assurance, and eligibility judgments withheld."
    },
