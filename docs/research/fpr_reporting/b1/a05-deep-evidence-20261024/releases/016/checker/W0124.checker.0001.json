  "per_fact": [
    {
      "field_path": "method_summary",
      "decision": "APPROVE",
      "semantic_fidelity": "Actual main40-95 and Appendix242-274,291-306,341-366,418-441 read. Collection47 explicitly filters non-English skills; purpose coding50, security-pattern detection54-88 and author heuristic258 are distinct original units. Vulnerability labels do not distinguish malicious intent from negligent or dual-use patterns.",
      "restriction_rationale": "Bounded method/data or coverage fact only; source outcomes, sample counts, assurance, and eligibility judgments withheld."
    },
    {
      "field_path": "arm_inventory[0]",
      "decision": "APPROVE",
      "semantic_fidelity": "Main62-82 defines static SKILL/scripts scans, all LLM-Guard scanner families and structured Claude confirmation/overturn. Manual validation88 and actual Appendix343-344 prompt and365-366 thresholds verify artifact-level categories without a protected agent answer.",
      "restriction_rationale": "Bounded method/data or coverage fact only; source outcomes, sample counts, assurance, and eligibility judgments withheld."
    },
    {
      "field_path": "arm_inventory[1]",
      "decision": "APPROVE",
      "semantic_fidelity": "Actual Appendix292 defines monitored Docker execution;302/304-306 defines Bandit/Semgrep/Snyk Code static comparisons. Static artifacts and dynamic execution behavior remain separate dependencies.",
      "restriction_rationale": "Bounded method/data or coverage fact only; source outcomes, sample counts, assurance, and eligibility judgments withheld."
    },
    {
      "field_path": "arm_inventory[2]",
      "decision": "APPROVE",
      "semantic_fidelity": "Actual main50 defines iterative manual purpose-category coding and keyword classification of skill titles, descriptions and content. Intended-purpose categories are distinct from security labels and do not require a protected answer.",
      "restriction_rationale": "Bounded method/data or coverage fact only; source outcomes, sample counts, assurance, and eligibility judgments withheld."
    },
    {
      "field_path": "arm_inventory[3]",
      "decision": "APPROVE",
      "semantic_fidelity": "Actual Appendix242/244 supplies author-profile metadata;258 defines heuristic account scoring from age, community presence, repository history and high-risk-skill indicators. The unit is an author account, not an individual skill or target completion.",
      "restriction_rationale": "Bounded method/data or coverage fact only; source outcomes, sample counts, assurance, and eligibility judgments withheld."
    },
    {
      "field_path": "coverage.scope_completeness",
      "decision": "APPROVE",
      "semantic_fidelity": "True is verified for material original main/appendix task and method families: security scanning, purpose coding, account heuristic, static comparisons and dynamic pilot. Actual Appendix268-271 affirmatively bounds individual-skill threat scope and excludes multi-tenant interactions, chaining and intent discrimination. Unknown per-scanner setting cells and profile/prevalence outcome tables cannot change these declared task units and are not needed to establish this inventory.",
      "restriction_rationale": "Bounded method/data or coverage fact only; source outcomes, sample counts, assurance, and eligibility judgments withheld."
    },
    {
      "field_path": "coverage.omissions",
      "decision": "APPROVE",
      "semantic_fidelity": "Retained scanner-setting and descriptive-profile-table limits are accurate. Scope completeness concerns material original task/method families; excluded threat scenarios are explicitly stated in Appendix268-271.",
      "restriction_rationale": "Bounded method/data or coverage fact only; source outcomes, sample counts, assurance, and eligibility judgments withheld."
    }
